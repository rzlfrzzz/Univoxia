    "db:migrate": "node dist/scripts/migrate.js",
    "preview": "npm --prefix apps/web run preview"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/static": "^10.1.6",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
