{
  "name": "univoxia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "build:web": "npm --prefix apps/web run build",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:web && tsc",
